{
  "manifest_version": 2,
  "name": "Video to Desktop",
  "version": "1.1.2",
  "description": "Download videos to Desktop, with optional local speech transcription and subtitles.",
  "browser_specific_settings": {
    "gecko": {
      "id": "video-downloader@local.invalid",
      "strict_min_version": "142.0",
      "data_collection_permissions": {"required": ["none"]}
    }
  },
  "permissions": ["activeTab", "menus", "nativeMessaging", "notifications"],
  "background": {"scripts": ["background.js"], "persistent": true},
  "browser_action": {
    "default_title": "Download video to Desktop",
    "default_icon": "icon.svg"
  },
  "icons": {"48": "icon.svg", "96": "icon.svg"}
}
